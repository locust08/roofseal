# Generate private local values and initialize the admin with npm run cms:setup.
PAYLOAD_SECRET=
DATABASE_URL=file:./.data/roofseal.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CMS_ADMIN_EMAIL=admin@roofseal.local
CMS_ADMIN_PASSWORD=

# The public site URL must be the canonical HTTPS origin in production.
# Set only to a single-IP header that your hosting proxy strips and overwrites.
# Without this setting, visitors share a conservative 5-enquiries/15-min limit.
ENQUIRY_IP_HEADER=

# Both delivery integrations remain disabled until deployment configuration.
ENQUIRY_EMAIL_ENABLED=false
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=

ENQUIRY_SHEETS_ENABLED=false
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Enquiries!A:K
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Server-only PEM key. Literal backslash-n sequences are supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
