{
  "name": "ai-website-clone-template",
  "version": "0.6.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "cms:setup": "tsx scripts/cms/setup.ts",
    "cms:download": "tsx scripts/cms/download-media.ts",
    "cms:import": "tsx scripts/cms/import.ts",
    "cms:reconcile-drive": "tsx scripts/cms/reconcile-drive.ts",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "enquiries:deliver": "tsx scripts/cms/deliver-enquiries.ts",
    "enquiries:recover": "tsx scripts/cms/recover-enquiry.ts",
    "cms:migrate": "payload migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "18.0.8",
    "google-auth-library": "^11.3.1",
    "graphql": "16.14.2",
    "lucide-react": "^1.6.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
